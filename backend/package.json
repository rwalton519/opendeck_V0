{
  "name": "transparent-poker-backend",
  "version": "1.0.0",
  "description": "Merged Node.js/Express backend for transparent_poker / OpenDeck (auth, admin, wallet, tournaments, cashgame, kyc, compliance, payments, scheduler).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "node db/seed.js",
    "test": "node --test test/known-gaps.test.js"
  },
  "dependencies": {
    "@privy-io/server-auth": "^1.32.5",
    "axios": "^1.7.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "modern-treasury": "^3.3.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "stripe": "^16.8.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1",
    "nodemon": "^3.1.4"
  }
}
