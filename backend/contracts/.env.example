# Used by contracts/deploy.js only. Do NOT put real secrets in this file -
# copy it to .env (already gitignored alongside the rest of the backend's
# .env) and fill in real values there.

POLYGON_RPC_URL=https://polygon-rpc.com
DEPLOYER_PRIVATE_KEY=0xyour_deployer_private_key
# Native USDC on Polygon mainnet - verify against Circle's current published
# address before deploying real funds against it:
# https://www.circle.com/en/multi-chain-usdc/polygon
USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
OPERATOR_ADDRESS=0xyour_backend_signing_wallet
RAKE_RECIPIENT_ADDRESS=0xyour_house_treasury_wallet
