# Copy this file to .env and fill in real values, then `npm start`.
# core/config.js loads this automatically via dotenv.

# --- Core ---
SECRET_KEY=dev-secret-key
JWT_ALGORITHM=HS256
DATABASE_URL=postgres://user:password@localhost:5432/opendeck
CORS_ORIGIN=http://localhost:5173
PORT=8000

# --- Polygon / USDC on-chain integration (services/blockchain/chainConfig.js) ---
POLYGON_CHAIN_ID=137
POLYGON_RPC_URL=
OPENDECK_POKER_CONTRACT_ADDRESS=
USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Operator wallet private key - the ONLY key allowed to call
# operatorSettleHand/setSeatedForWithdrawal on the contract. Treat like a
# payment processor's API secret: never log it, never send it to the
# frontend.
OPENDECK_OPERATOR_PRIVATE_KEY=
POLYGON_REQUIRED_CONFIRMATIONS=15

# --- Privy (services/privy/privyConfig.js) ---
# App ID: public identifier, safe to expose client-side too (same value as
# the frontend's VITE_PRIVY_APP_ID). Powers embedded-wallet auto-creation
# on email login (src/providers/PrivyProviders.tsx on the frontend).
PRIVY_APP_ID=
# App Secret: PRIVATE. Only needed if this backend verifies a Privy
# identity/session token server-side (see services/privy/privyClient.js).
# Never expose this in frontend code, logs, or source control.
PRIVY_APP_SECRET=

# --- Stripe (routers/wallet.js, walletStripeConnect.js, walletWebhooks.js) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Modern Treasury (services/payments) ---
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORG_ID=

# --- Compliance / KYC ---
# JSON object keyed by KYC tier. Each tier must define a non-negative deposit limit.
# Example: KYC_DEPOSIT_LIMITS_JSON={"unverified":{"deposit":0},"verified":{"deposit":5000}}
KYC_DEPOSIT_LIMITS_JSON=

# --- Misc ---
# DB_SYNC_ALTER=true       # allow sequelize.sync({alter:true}) on boot
# SEED_ALLOW_NONLOCAL=true # allow db/seed.js to run against a non-local DB
