# Copy this file to .env.local and fill in real values.
# Because these are the only two lines that name a backend host anywhere
# in the app, pointing the app at a future Node.js backend is a one-line
# change here -- not a code change.

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Separate, payment-free SideBet prediction-market API.
VITE_SIDEBET_API_BASE_URL=http://localhost:4000

# Stripe's publishable key - safe to expose client-side (unlike the
# backend's STRIPE_API_KEY). Powers the card/debit deposit form
# (src/components/wallet/CardDepositFlow.tsx). Get this from the Stripe
# dashboard -> Developers -> API keys -> "Publishable key". It must be from
# the SAME Stripe account/mode (test vs. live) as the backend's
# STRIPE_API_KEY, or PaymentIntent creation will succeed on the backend but
# confirmation will fail on the frontend with a key-mismatch error.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Privy's public App ID (Dashboard -> App settings -> App ID). Safe to
# expose client-side - it's what powers embedded-wallet auto-creation on
# email login (src/providers/PrivyProviders.tsx). The matching App Secret
# is backend-only; never put it behind a VITE_ prefix (see backend/.env.example).
VITE_PRIVY_APP_ID=replace_me
